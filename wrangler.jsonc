{
  // Cloudflare Workers + static assets: serves the Vite build (dist/) for steelsync.ph and every
  // gym subdomain (<slug>.steelsync.ph). Cloudflare Pages cannot serve wildcard hostnames, a Worker route can.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssph-website-ui",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Single-page app: any path that is not a file (/admin/members, /coach, ...) returns index.html.
    // This replaces the old `/* /index.html 200` rule in public/_redirects.
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "steelsync.ph", "custom_domain": true },
    { "pattern": "www.steelsync.ph", "custom_domain": true },
    { "pattern": "*.steelsync.ph/*", "zone_name": "steelsync.ph" }
  ]
}
